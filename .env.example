# Validex local development (copy to .env). Defaults work with no external services.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./validex.db
# DATABASE_URL=postgresql://aicte:aicte_secret@localhost:5432/aicte_validation

# Async processing: false = FastAPI background tasks; true = Celery + Redis workers
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Object storage: falls back to backend/storage_vault when MinIO is unreachable
USE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=aicte-documents

# Issuing-authority connector: empty = in-process simulated sources; or URL of the mock-authority service
AUTHORITY_API_URL=

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_MB=25
RETENTION_DAYS=365

# Optional SMTP for emailing deficiency notices (in-app notices always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@validex.local
