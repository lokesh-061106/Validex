# Used by docker-compose.prod.yml. Every value marked REQUIRED must be set.
SECRET_KEY=                 # REQUIRED: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=aicte
POSTGRES_PASSWORD=          # REQUIRED
POSTGRES_DB=aicte_validation
MINIO_ROOT_USER=            # REQUIRED
MINIO_ROOT_PASSWORD=        # REQUIRED (8+ chars)
NEO4J_PASSWORD=             # REQUIRED (collusion graph)
CORS_ORIGINS=https://validex.example.gov.in
RETENTION_DAYS=365
# Optional one-time setup for a new, empty production database. Use a real account
# controlled by your organization and a unique password of at least 16 characters.
# Remove both variables from the hosting provider immediately after first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Portal Administrator
# Point to a real/sandbox verification gateway when available; defaults to the simulated sources
AUTHORITY_API_URL=http://mock-authority:8100
